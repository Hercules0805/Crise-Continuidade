# ID da planilha Google Sheets (fonte de verdade atual)
SPREADSHEET_ID=

# Caminho do JSON da service account com acesso a Sheets (leitura) e Firestore (escrita)
# A mesma service account precisa de: Google Sheets API (viewer da planilha) e
# papel "Cloud Datastore User" / "Firebase Admin" no projeto.
GOOGLE_CREDENTIALS_PATH=./service-account.json

# Projeto Firebase de destino
FIREBASE_PROJECT_ID=bia-forte-2025

# Opcional: para testar contra o emulador local em vez de produção
# FIRESTORE_EMULATOR_HOST=localhost:8080
