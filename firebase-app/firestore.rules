rules_version = '2';

// Regras de segurança do Firestore — projeto bia-forte-2025.
//
// Modelo de perfis — RBAC cumulativo (28/09/2026). Espelha public/perfis.js.
//   - Acesso exige usuário autenticado com e-mail @fortestecnologia.com.br.
//   - Perfis vêm de config_perfis/{email}, no array `perfis` (o campo `perfil`
//     string fica por compat com documentos antigos). Uma pessoa pode ter mais
//     de um perfil; o poder é a UNIÃO deles.
//   - admin: acesso total, inclusive perfis, perguntas do BIA e régua.
//   - seguranca (Segurança da Informação): opera todos os módulos MENOS o que é
//     próprio do Admin (perfis, perguntas, config_respostas/config_regua).
//   - ti: opera o DRP — escreve no catálogo de dependencias (parâmetros DRP) e
//     NADA além disso; não gera PCN/DRP (isso é do cliente), não mexe em áreas,
//     fornecedores, riscos, perguntas nem perfis.
//   - gestor: lê tudo; escreve processos/respostas/riscos só da PRÓPRIA área.
//   - Leitura das coleções de dados: qualquer usuário do domínio (exceto tokens
//     e historico_risco, mais restritos).
//   - O perfil 'fornecedores' foi extinto; migra para 'seguranca' no cliente.
//   - tokens de avaliação externa: fechados aqui (só as Cloud Functions leem).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isCorpUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@fortestecnologia[.]com[.]br$');
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function perfilDoc() {
      return get(/databases/$(database)/documents/config_perfis/$(emailKey()));
    }

    function hasPerfil() {
      return exists(/databases/$(database)/documents/config_perfis/$(emailKey()));
    }

    // RBAC cumulativo (28/09/2026): uma pessoa pode ter mais de um perfil.
    // A verdade e o array `perfis`; o campo `perfil` (string) fica so por
    // compatibilidade com documentos antigos ainda nao regravados, e vale como
    // um perfil unico. temPerfil() cobre os dois — se um dia todo documento
    // tiver `perfis`, o segundo termo simplesmente nunca casa.
    //
    // Os nomes ('admin','seguranca','ti','gestor') espelham public/perfis.js;
    // um teste falha se as duas listas divergirem. O perfil 'fornecedores' foi
    // extinto: quem o tinha passa a Seguranca da Informacao (migracao no
    // cliente, em api.js _lerPerfil).
    function temPerfil(p) {
      return isCorpUser() && hasPerfil()
        && ( ('perfis' in perfilDoc().data && perfilDoc().data.perfis is list
              && perfilDoc().data.perfis.hasAny([p]))
             || perfilDoc().data.perfil == p );
    }

    function isAdmin() {
      return temPerfil('admin');
    }

    // Seguranca da Informacao: opera todos os modulos, MENOS o que e proprio do
    // Admin — Perfis de Acesso, Perguntas do BIA e a Regua de criticidade
    // (config_respostas/config_regua). Se pudesse mexer em perfis, se promoveria
    // a admin, e o limite nao seria limite.
    function isSeguranca() {
      return temPerfil('seguranca');
    }

    // TI: opera o DRP. Edita parametros de dependencia (necessarios ao DRP), mas
    // NAO gera PCN nem DRP (isso e Admin+SI) e nao mexe em perguntas/regua/perfis.
    function isTI() {
      return temPerfil('ti');
    }

    // Modulo de fornecedores: antes tinha perfil proprio; agora e Admin ou
    // Seguranca da Informacao. (Espelha Perfis.podeGerenciarFornecedores.)
    function podeGerenciarFornecedores() {
      return isAdmin() || isSeguranca();
    }

    // Quem mexe no catalogo de dependencias: Admin, SI e TI. TI precisa editar
    // dependencias para montar o DRP. (Espelha Perfis.podeMexerNaDependencia.)
    function podeMexerNaDependencia() {
      return isAdmin() || isSeguranca() || isTI();
    }

    // Quem mexe em Areas: Admin e SI. (Espelha Perfis.podeMexerNaArea.)
    function podeMexerNaArea() {
      return isAdmin() || isSeguranca();
    }

    // Área que dá PODER DE GESTOR ao usuário: o campo `area` do config_perfis,
    // mas SÓ quando a pessoa realmente tem o perfil 'gestor'.
    //
    // ATENCAO: area VAZIA nao e area.
    //
    // Duas armadilhas que esta função fecha, nesta ordem:
    //
    // 1) area vazia. A regra original só testava se o campo `area` existia. Um
    //    documento com `area: ''` passava a valer como "gestor da area vazia".
    //    E os riscos corporativos (os gerados por desvio de indicador e por nota
    //    de fornecedor) nascem justamente com area vazia: qualquer pessoa com
    //    `area: ''` leria e escreveria neles. Daí a comparação com ''.
    //
    // 2) area sem ser gestor (28/09/2026). Agora a Área aparece na tela para
    //    QUALQUER perfil e é gravada mesmo para quem não é gestor (ex.: mostrar
    //    a área do pessoal de Segurança da Informação). Sem o teste de perfil
    //    aqui, gravar a área de um SI o tornaria gestor daquela área — leria
    //    riscos e escreveria processos dela pela rota de gestor, sem ser gestor.
    //    Por isso: só é "gestor da área" quem TEM o perfil gestor. Admin e SI já
    //    têm o que precisam pelas próprias permissões, não por esta rota.
    function gestorArea() {
      return temPerfil('gestor')
        && ('area' in perfilDoc().data)
        && perfilDoc().data.area != null
        && perfilDoc().data.area != ''
        ? perfilDoc().data.area : null;
    }

    function isGestorDaArea(area) {
      return isCorpUser() && gestorArea() != null && gestorArea() == area;
    }

    // ---- Catálogos e configurações: leitura p/ domínio, escrita p/ admin ----
    // Perguntas do BIA: proprio do Admin. SI NAO edita perguntas (fronteira do
    // que e "atividade propria do Admin", decisao 28/09/2026).
    match /perguntas/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /areas/{id} {
      allow read: if isCorpUser();
      // Areas: Admin e Seguranca da Informacao. (ver public/perfis.js,
      // podeMexerNaArea.)
      allow write: if podeMexerNaArea();
    }

    // /dependencias guarda o catalogo dos 5 Ps do BIA (Fornecedores,
    // Infraestrutura, Pessoas, Sistemas, Processos Internos) e os parametros de
    // DRP de cada dependencia.
    //
    // DECISAO 28/09/2026: com o fim do perfil 'fornecedores' cai a guarda por
    // categoria. Quem escreve aqui e Admin, Seguranca da Informacao (opera todos
    // os modulos) e TI (precisa editar dependencias para montar o DRP). Nenhum
    // deles fica preso a uma categoria — o recorte por categoria existia so para
    // conter o antigo perfil de fornecedores, que nao existe mais.
    match /dependencias/{id} {
      allow read: if isCorpUser();
      allow write: if podeMexerNaDependencia();
    }

    match /componentes/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    // DECISAO 19/09/2026: admin le tudo, gestor le so a propria area.
    //
    // Antes a leitura era liberada para qualquer conta do dominio — nao para os
    // 16 perfis cadastrados, mas para a empresa inteira — e o registro traz
    // impacto financeiro estimado, plano de acao e KRIs.
    //
    // ATENCAO ao mexer: com regra por documento, uma consulta SEM filtro de
    // area falha INTEIRA para o gestor, e nao devolve menos. O cliente tem de
    // consultar com where('area','==',<area do gestor>) — ver _lerRiscos em
    // api.js. Mudar um lado sem o outro quebra a tela de riscos.
    match /riscos/{id} {
      allow read: if isAdmin() || isGestorDaArea(resource.data.area);
      allow write: if isAdmin();
    }

    match /indicadores_seguranca/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    // Lancamentos mensais dos indicadores: um documento por (indicador, mes).
    // Antes viviam numa lista dentro do documento do indicador, regravada
    // inteira a cada lancamento — dois administradores lancando ao mesmo tempo
    // apagavam o trabalho um do outro, em silencio. Um documento por mes acaba
    // com isso e ainda permite consultar "quem ficou fora da meta em marco".
    match /lancamentos_indicadores/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /config_respostas/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    // Versao da regua de pesos. Sobe a cada edicao de config_respostas e fica
    // carimbada em cada avaliacao, para que mudar os pesos nao reescreva o
    // significado do historico em silencio. Leitura ampla porque todo calculo
    // precisa saber a versao corrente; escrita so de admin, como a regua.
    match /config_regua/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /config_perfis/{email} {
      // Qualquer usuário do domínio lê (necessário para resolver o próprio perfil).
      allow read: if isCorpUser();

      // Só admin mexe em perfil de acesso. Nem SI nem TI: se qualquer um
      // pudesse editar config_perfis, se promoveria a admin e o limite não
      // seria limite nenhum.
      //
      // A exceção é estreita de propósito: o gestor pode gravar a PRÓPRIA área
      // resolvida pelo e-mail responsável (o cliente faz isso no primeiro
      // login, porque as regras do gestor dependem do campo area). Ele não
      // pode tocar em perfis/perfil (a lista de acessos) nem no documento de
      // outra pessoa.
      allow update: if isAdmin()
        || (isCorpUser()
            && email == emailKey()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perfil', 'perfis']));
      allow create: if isAdmin()
        || (isCorpUser()
            && email == emailKey()
            && !('perfil' in request.resource.data)
            && !('perfis' in request.resource.data));
      allow delete: if isAdmin();
    }

    // ---- Dados operacionais: admin (tudo) ou gestor (própria área) ----
    match /processos/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin()
        || isGestorDaArea(request.resource.data.area)
        || (resource != null && isGestorDaArea(resource.data.area));
    }

    match /respostas_bia/{id} {
      allow read: if isCorpUser();
      allow create: if isAdmin() || isGestorDaArea(request.resource.data.area);
      // Respostas são registros históricos: não permitir update/delete pelo app.
      allow update, delete: if isAdmin();
    }

    // ---- Livro de medicoes ----
    // Base do monitor de risco no tempo. Uma linha por medicao, nunca apagada.
    //
    // Escrita: SO pelo servidor. Quem grava e o gatilho medicaoDeBia (e, adiante,
    // os outros insumos), com Admin SDK, que ignora estas regras. Nenhum cliente
    // escreve aqui — um ponto da curva forjado pelo navegador destruiria a
    // credibilidade do monitor inteiro.
    //
    // Leitura: mesmo recorte dos riscos — admin ve tudo, gestor ve a propria
    // area. Vale a mesma armadilha: com regra por documento, consulta sem
    // filtro de area falha inteira para o gestor.
    // ---- Fornecedores ----
    // O cadastro do fornecedor em si vive em /dependencias (categoria
    // Fornecedores) — nao existe cadastro paralelo, de proposito.
    //
    // Escrita somente admin, igual aos outros catalogos. Se Compras ou Juridico
    // forem avaliar sem serem admin, isto precisa de um perfil "avaliador" —
    // decisao em aberto, registrada no roteiro de evolucao.
    match /criterios_fornecedor/{id} {
      allow read: if isCorpUser();
      allow write: if podeGerenciarFornecedores();
    }

    // Categorias de segmento do fornecedor (ex.: "Nuvem, Data Center e
    // Ciberseguranca") -- classificacao de negocio, nao entra em calculo
    // nenhum. Mesma permissao dos criterios de avaliacao.
    match /categorias_fornecedor/{id} {
      allow read: if isCorpUser();
      allow write: if podeGerenciarFornecedores();
    }

    // Append-only: cada avaliacao e um documento novo, a mais recente vale.
    // Sem update e sem delete — o historico da nota do fornecedor e o que
    // permite mostrar a evolucao dele, e uma nota apagada nao se recupera.
    match /avaliacoes_fornecedor/{id} {
      allow read: if isCorpUser();
      allow create: if podeGerenciarFornecedores();
      allow update, delete: if false;
    }

    match /medicoes/{id} {
      allow read: if isAdmin() || isGestorDaArea(resource.data.area);
      allow write: if false;
    }

    // ---- Retrato diario do risco consolidado (Fase 5 -- O monitor) ----
    // Um documento por dia, com a carga da empresa E de todas as areas juntas
    // (nao um documento por area). Por isso a leitura e SO ADMIN por enquanto:
    // abrir para cada gestor ver so a propria area exigiria guardar um
    // documento por area por dia (como riscos/medicoes ja fazem), que e uma
    // mudanca maior -- registrada na aba Roadmap como pendencia, nao decidida
    // a construir agora.
    //
    // Escrita: SO pelo servidor (retratoDiarioRisco, e o backfill manual, os
    // dois com Admin SDK). Mesma razao do livro de medicoes: um ponto da
    // curva forjado pelo navegador destroi a credibilidade do monitor.
    match /historico_risco/{dia} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Tokens ----
    // FECHADO PARA TODO MUNDO, de propósito (20/09/2026).
    //
    // Nenhuma tela lê esta coleção pelo SDK — verificado em todo o public/.
    // Quem cria e valida token são as Cloud Functions (appApi e tokenApi), que
    // usam o Admin SDK e não passam por estas regras.
    //
    // A leitura antes liberada para o domínio permitia a qualquer funcionário
    // baixar todos os links de avaliação ainda não usados, com área, processo e
    // destinatário — e responder no lugar do gestor legítimo.
    match /tokens/{token} {
      allow read, write: if false;
    }

    // Nega tudo que não casou acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
