rules_version = '2';

// Regras de segurança do Firestore — projeto bia-forte-2025.
//
// Modelo de perfis (espelha o controle atual do sistema):
//   - Acesso exige usuário autenticado com e-mail @fortestecnologia.com.br.
//   - Leitura de todas as coleções de dados: qualquer usuário do domínio.
//   - Escrita em catálogos e configurações (perguntas, areas, dependencias,
//     componentes, riscos, indicadores_seguranca, config_respostas,
//     config_perfis): somente admin.
//   - Escrita em processos e respostas_bia: admin, ou gestor da própria área.
//   - Perfil (admin/gestor) vem de config_perfis/{email}.
//   - tokens de avaliação externa (sem login) são tratados na Task 8; por ora
//     só admin escreve e usuários do domínio leem.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isCorpUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@fortestecnologia[.]com[.]br$');
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function perfilDoc() {
      return get(/databases/$(database)/documents/config_perfis/$(emailKey()));
    }

    function hasPerfil() {
      return exists(/databases/$(database)/documents/config_perfis/$(emailKey()));
    }

    function isAdmin() {
      return isCorpUser() && hasPerfil() && perfilDoc().data.perfil == 'admin';
    }

    // Área vinculada ao gestor: em config_perfis (campo area) OU, se ausente,
    // pela área cujo e-mail de responsável é o do usuário (resolvido no cliente
    // e replicado aqui via config_perfis.area quando disponível).
    function gestorArea() {
      return hasPerfil() && ('area' in perfilDoc().data) ? perfilDoc().data.area : null;
    }

    function isGestorDaArea(area) {
      return isCorpUser() && gestorArea() != null && gestorArea() == area;
    }

    // ---- Catálogos e configurações: leitura p/ domínio, escrita p/ admin ----
    match /perguntas/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /areas/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /dependencias/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /componentes/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    // DECISAO 19/09/2026: admin le tudo, gestor le so a propria area.
    //
    // Antes a leitura era liberada para qualquer conta do dominio — nao para os
    // 16 perfis cadastrados, mas para a empresa inteira — e o registro traz
    // impacto financeiro estimado, plano de acao e KRIs.
    //
    // ATENCAO ao mexer: com regra por documento, uma consulta SEM filtro de
    // area falha INTEIRA para o gestor, e nao devolve menos. O cliente tem de
    // consultar com where('area','==',<area do gestor>) — ver _lerRiscos em
    // api.js. Mudar um lado sem o outro quebra a tela de riscos.
    match /riscos/{id} {
      allow read: if isAdmin() || isGestorDaArea(resource.data.area);
      allow write: if isAdmin();
    }

    match /indicadores_seguranca/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    // Lancamentos mensais dos indicadores: um documento por (indicador, mes).
    // Antes viviam numa lista dentro do documento do indicador, regravada
    // inteira a cada lancamento — dois administradores lancando ao mesmo tempo
    // apagavam o trabalho um do outro, em silencio. Um documento por mes acaba
    // com isso e ainda permite consultar "quem ficou fora da meta em marco".
    match /lancamentos_indicadores/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /config_respostas/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    // Versao da regua de pesos. Sobe a cada edicao de config_respostas e fica
    // carimbada em cada avaliacao, para que mudar os pesos nao reescreva o
    // significado do historico em silencio. Leitura ampla porque todo calculo
    // precisa saber a versao corrente; escrita so de admin, como a regua.
    match /config_regua/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    match /config_perfis/{email} {
      // Qualquer usuário do domínio lê (necessário para resolver o próprio perfil);
      // apenas admin altera perfis.
      allow read: if isCorpUser();
      allow write: if isAdmin();
    }

    // ---- Dados operacionais: admin (tudo) ou gestor (própria área) ----
    match /processos/{id} {
      allow read: if isCorpUser();
      allow write: if isAdmin()
        || isGestorDaArea(request.resource.data.area)
        || (resource != null && isGestorDaArea(resource.data.area));
    }

    match /respostas_bia/{id} {
      allow read: if isCorpUser();
      allow create: if isAdmin() || isGestorDaArea(request.resource.data.area);
      // Respostas são registros históricos: não permitir update/delete pelo app.
      allow update, delete: if isAdmin();
    }

    // ---- Livro de medicoes ----
    // Base do monitor de risco no tempo. Uma linha por medicao, nunca apagada.
    //
    // Escrita: SO pelo servidor. Quem grava e o gatilho medicaoDeBia (e, adiante,
    // os outros insumos), com Admin SDK, que ignora estas regras. Nenhum cliente
    // escreve aqui — um ponto da curva forjado pelo navegador destruiria a
    // credibilidade do monitor inteiro.
    //
    // Leitura: mesmo recorte dos riscos — admin ve tudo, gestor ve a propria
    // area. Vale a mesma armadilha: com regra por documento, consulta sem
    // filtro de area falha inteira para o gestor.
    match /medicoes/{id} {
      allow read: if isAdmin() || isGestorDaArea(resource.data.area);
      allow write: if false;
    }

    // ---- Tokens ----
    // FECHADO PARA TODO MUNDO, de propósito (20/09/2026).
    //
    // Nenhuma tela lê esta coleção pelo SDK — verificado em todo o public/.
    // Quem cria e valida token são as Cloud Functions (appApi e tokenApi), que
    // usam o Admin SDK e não passam por estas regras.
    //
    // A leitura antes liberada para o domínio permitia a qualquer funcionário
    // baixar todos os links de avaliação ainda não usados, com área, processo e
    // destinatário — e responder no lugar do gestor legítimo.
    match /tokens/{token} {
      allow read, write: if false;
    }

    // Nega tudo que não casou acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
